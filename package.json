{
  "name": "bb-plugin-tinkerer",
  "version": "0.1.0",
  "description": "Tinkerer Club inside bb: timeline, inbox, lock-in sessions, your level and sparks, a post composer, agent tools, and a bb tinkerer CLI.",
  "license": "MIT",
  "author": "Vedran Burojević (https://github.com/vburojevic)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vburojevic/bb-plugin-tinkerer.git"
  },
  "homepage": "https://github.com/vburojevic/bb-plugin-tinkerer#readme",
  "keywords": [
    "bb",
    "bb-plugin",
    "tinkerer",
    "tinkerer-club",
    "community",
    "build-in-public"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "gen:procedures": "node scripts/gen-procedures.mjs"
  },
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.4.104"
  },
  "bb": {
    "name": "Tinkerer",
